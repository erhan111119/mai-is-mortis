{
  "manifest_version": 2,
  "id": "github.erhan111119.mai-is-mortis",
  "version": "1.0.0",
  "name": "mai is mortis",
  "description": "麦麦是多首的怪物：被骂就长出一颗嘴臭的头，被夸就长出一颗撒娇的头。加分的唯一来源是模型判定——插件把最近的对话交给模型，按每个人格的一句话判定条件决定谁加分；某个头分数顶到阈值就顶替掉主人格，其他人格分数清零，维持一段时间后自动切回，分数还会随时间衰减。人格、判定条件、阈值、时长全部可在 WebUI 里改，支持 /人格 查看分数与手动切换。",
  "author": {
    "name": "erhan111119",
    "url": "https://github.com/erhan111119"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/erhan111119/mai-is-mortis",
    "homepage": "https://github.com/erhan111119/mai-is-mortis",
    "documentation": "https://github.com/erhan111119/mai-is-mortis/blob/main/README.md",
    "issues": "https://github.com/erhan111119/mai-is-mortis/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.10.0",
    "max_version": "2.99.99"
  },
  "plugin_type": "extension",
  "dependencies": [],
  "capabilities": [
    "config.get",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
